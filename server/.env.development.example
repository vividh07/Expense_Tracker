# =============================================================================
# CODING LAPTOP / LOCAL DEV only
# Copy to server/.env while developing (do not use this on the deploy laptop)
# =============================================================================

PORT=5000
NODE_ENV=development

# Optional if MongoDB Community is installed locally:
MONGODB_URI=mongodb://127.0.0.1:27017/expense-tracker

# Use 1 when MongoDB is NOT installed on the coding PC (data resets on restart)
USE_MEMORY_DB=1

JWT_SECRET=dev_only_secret_change_me

# Match your Vite port (5173 / 5174 / 5175…)
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
