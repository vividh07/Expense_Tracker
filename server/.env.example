# =============================================================================
# PRODUCTION / DEPLOY LAPTOP template
# Copy to .env and fill in values. Never commit your real .env file.
# =============================================================================

PORT=5000
NODE_ENV=production

# Real MongoDB on this machine (required in production)
MONGODB_URI=mongodb://127.0.0.1:27017/expense-tracker

# MUST stay unset/off in production — memory DB is blocked when NODE_ENV=production
# USE_MEMORY_DB=1

JWT_SECRET=pick_a_long_random_secret_here

# Public site URL (Cloudflare Tunnel https://… or http://localhost:5000 for local host test)
CLIENT_URL=http://localhost:5000

GOOGLE_CLIENT_ID=
